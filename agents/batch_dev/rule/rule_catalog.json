{
  "version": "4.0",
  "description": "처리 패턴은 rule_catalog가 정의하고, 실제 물리 테이블/컬럼은 ERWin table_role/column role로 결정한다. 업무별 if문과 물리 테이블명 고정을 두지 않는다.",
  "rules": [
    {
      "rule_id": "monthly_aggregation_dynamic",
      "rule_type": "monthly_aggregation",
      "batch_type": "aggregation_to_table",
      "priority": 100,
      "description": "거래 원장 역할 테이블과 분류 마스터 relation을 기준으로 월별 집계 SQL을 생성한다.",
      "match": {
        "required_table_roles": [
          "transaction_ledger",
          "classification_master"
        ],
        "required_capabilities": [
          "aggregation",
          "group_by"
        ],
        "capability_any": [
          "classification_join",
          "effective_date_matching",
          "exclude_cancelled",
          "base_month_parameter",
          "replace_partition",
          "aggregation_source",
          "classification_relation_available"
        ]
      },
      "target": {
        "table_role": "monthly_summary",
        "column_roles": [
          "customer_id",
          "base_month",
          "classification_type",
          "amount_sum",
          "row_count",
          "reg_datetime"
        ],
        "load_strategy": "delete_insert",
        "partition_column_role": "base_month",
        "partition_param": "base_ym"
      }
    },
    {
      "rule_id": "ledger_extract_with_classification",
      "rule_type": "ledger_extract",
      "batch_type": "db_to_file",
      "priority": 80,
      "description": "거래 원장과 분류 마스터를 ERWIN relation 기반으로 조인하여 대상 거래를 추출한다.",
      "match": {
        "required_table_roles": [
          "transaction_ledger",
          "classification_master"
        ],
        "required_capabilities": [
          "classification_join",
          "classification_relation_available"
        ],
        "capability_any": [
          "file_export",
          "effective_date_matching"
        ],
        "exclude_capabilities": [
          "aggregation",
          "group_by"
        ]
      },
      "template_type": "ledger_extract_with_classification",
      "sql_template": "ledger_extract_with_classification.sql.j2"
    },
    {
      "rule_id": "generic_export_dynamic",
      "rule_type": "generic_export",
      "batch_type": "db_to_file",
      "priority": 10,
      "description": "단일 테이블 조건 조회 후 파일로 생성한다.",
      "match": {
        "capability_any": [
          "file_export"
        ],
        "exclude_capabilities": [
          "aggregation",
          "group_by",
          "classification_join"
        ]
      },
      "sql_template": "generic_export.sql.j2",
      "conditions": [
        {
          "template": ":base_date >= APPLY_START_DT"
        },
        {
          "template": "(APPLY_END_DT IS NULL OR :base_date <= APPLY_END_DT)"
        },
        {
          "template": "USE_YN = 'Y'"
        }
      ]
    }
  ]
}
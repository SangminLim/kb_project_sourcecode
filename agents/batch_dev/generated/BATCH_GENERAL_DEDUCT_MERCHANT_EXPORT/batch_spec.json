{
  "version": "1.0",
  "batch_id": "BATCH_GENERAL_DEDUCT_MERCHANT_EXPORT",
  "batch_name": "일반 소득공제 가맹점 파일 생성",
  "batch_type": "db_to_file",
  "description": "[배치 개발 요청서] 배치명: 일반 소득공제 가맹점 파일 생성 기준 테이블: - TB_GENERAL_DEDUCT_MERCHANT 출력 목적: - 일반 소득공제 대상 가맹점 정보 추출 출력 형식: - CSV 파일명: - general_deduct_merchant_YYYYMMDD.csv 기준일자: - APPLY_START_DT 처리 내용: - 일반 소득공제 대상 가맹점 정보를 조회한다. - 기준일자가 적용시작일자와 종료일자 사이인 데이터만 조회한다. - 사용여부가 'Y'인 데이터만 추출한다. 출력 컬럼: - MERCHANT_ID - MERCHANT_NM - BIZ_NO - MCC_CD - APPLY_START_DT - APPLY_END_DT - USE_YN 조건: - USE_YN = 'Y' - 기준일자 BETWEEN APPLY_START_DT AND APPLY_END_DT 배치 유형: - 파일 생성 배치 - 일 배치",
  "schedule_type": "daily",
  "parameters": [
    {
      "name": "base_date",
      "required": true,
      "description": "기준일자(YYYYMMDD)"
    }
  ],
  "source": {
    "table": "TB_GENERAL_DEDUCT_MERCHANT",
    "columns": [
      "MERCHANT_ID",
      "MERCHANT_NM",
      "BIZ_NO",
      "MCC_CD",
      "APPLY_START_DT",
      "APPLY_END_DT",
      "USE_YN"
    ],
    "table_role": "classification_master",
    "column_roles": [],
    "base_date_column_role": "effective_date_range",
    "base_date_column": "APPLY_START_DT",
    "effective_date": {
      "start_column": "APPLY_START_DT",
      "end_column": "APPLY_END_DT",
      "parameter": "base_date",
      "use_flag_column": "USE_YN"
    },
    "dynamic_inference": true
  },
  "target": {
    "output_format": "csv",
    "output_file_prefix": "general_deduct_merchant",
    "output_file_pattern": "general_deduct_merchant_{base_date}.csv",
    "output_dir": "./output",
    "encoding": "utf-8-sig"
  },
  "sql": "SELECT\nMERCHANT_ID,\n    MERCHANT_NM,\n    BIZ_NO,\n    MCC_CD,\n    APPLY_START_DT,\n    APPLY_END_DT,\n    USE_YN\nFROM TB_GENERAL_DEDUCT_MERCHANT\nWHERE USE_YN = 'Y'\n  AND APPLY_START_DT <= :base_date\n  AND (APPLY_END_DT IS NULL OR APPLY_END_DT >= :base_date)",
  "validation_rules": {
    "min_rows": 0,
    "not_null_columns": [

{
  "version": "1.0",
  "batch_id": "BATCH_TRAD_MARKET_MERCHANT_EXPORT",
  "batch_name": "전통시장 가맹점 파일 생성",
  "batch_type": "db_to_file",
  "schedule_type": "daily",
  "parameters": [
    {
      "name": "base_date",
      "required": true,
      "description": "기준일자(YYYYMMDD)"
    }
  ],
  "source": {
    "table": "TB_TRAD_MARKET_MERCHANT",
    "columns": [
      "MERCHANT_ID",
      "MERCHANT_NM",
      "MARKET_NM",
      "BIZ_NO"
    ],
    "table_role": "classification_master",
    "base_date_column_role": "effective_date_range",
    "base_date_column": "APPLY_START_DT",
    "effective_date": {
      "start_column": "APPLY_START_DT",
      "end_column": "APPLY_END_DT",
      "parameter": "base_date",
      "use_flag_column": "USE_YN"
    }
  },
  "target": {
    "output_format": "csv",
    "output_file_prefix": "traditional_market_merchant",
    "output_file_pattern": "traditional_market_merchant_{base_date}.csv",
    "output_dir": "./output",
    "encoding": "utf-8-sig"
  },
  "sql": "SELECT\nMERCHANT_ID,\n    MERCHANT_NM,\n    MARKET_NM,\n    BIZ_NO\nFROM TB_TRAD_MARKET_MERCHANT\nWHERE USE_YN = 'Y'\n  AND APPLY_START_DT <= :base_date\n  AND (APPLY_END_DT IS NULL OR APPLY_END_DT >= :base_date)",
  "validation_rules": {
    "min_rows": 0,
    "not_null_columns": [
      "MERCHANT_ID"
    ]
  }
}